  "search_marked_completed_with_recipes": [
    {
      "declarations": ["input name", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "「{name}」を完了にし、レシピを{count}件解放しました"
      }
    }
  ],
  "search_reset": "「{name}」をリセットしました",
  "action_undo": "元に戻す",
  "undo_marked_complete": "「{name}」を完了にしました",
  "undo_unmarked": "「{name}」を未完了に戻しました"
