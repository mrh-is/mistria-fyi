  "toolbar_search": "検索",
  "toolbar_quick_settings": "クイック設定",
  "toolbar_send_feedback": "フィードバックを送信",
  "toolbar_visibility_filters": "表示フィルター",
  "toolbar_close_panel": "パネルを閉じる",
  "toolbar_filters": "フィルター",
  "toolbar_reset_filters": "リセット",
  "toolbar_filters_applied": "フィルターを適用しました",
  "toolbar_filters_cleared": "フィルターをすべて解除しました",
  "page_header_back_to_home": "ホームに戻る",
  "page_header_progress": "{total}件中{completed}件完了",
  "foldout_close": "{title}を閉じる",
  "search_results_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "{count}件の結果"
      }
    }
  ],
  "search_no_results": "アイテムが見つかりません",
