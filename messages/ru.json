  "search_marked_completed_with_recipes": [
    {
      "declarations": ["input name", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "«{name}» отмечено как выполненное, разблокирован {count} рецепт",
        "countPlural=few": "«{name}» отмечено как выполненное, разблокировано {count} рецепта",
