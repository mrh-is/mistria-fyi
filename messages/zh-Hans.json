{
  "$schema": "https://inlang.com/schema/inlang-message-format",
  "app_name": "Mistria Field Guide",
  "toolbar_nav_label": "追踪工具",
  "toolbar_search_label": "搜索物品",
  "toolbar_search_placeholder": "搜索物品…",
  "toolbar_clear_search": "清除搜索",
  "toolbar_cancel_search": "取消",
  "toolbar_search": "搜索",
  "toolbar_quick_settings": "快速设置",
  "toolbar_send_feedback": "发送反馈",
  "toolbar_visibility_filters": "显示筛选",
  "toolbar_close_panel": "关闭面板",
  "toolbar_filters": "筛选",
  "toolbar_reset_filters": "重置",
  "toolbar_filters_applied": "已应用筛选",
  "toolbar_filters_cleared": "已清除所有筛选",
  "page_header_back_to_home": "返回首页",
  "page_header_progress": "已完成 {completed}/{total}",
  "foldout_close": "关闭{title}",
  "search_results_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "{count} 个结果"
      }
    }
  ],
  "search_no_results": "未找到任何物品",
  "search_marked_obtained": "已将“{name}”标记为已获得",
  "search_marked_completed": "已将“{name}”标记为已完成",
  "search_marked_completed_with_recipe": "已将“{name}”标记为已完成，并解锁了“{recipe}”",
  "search_marked_completed_with_recipes": [
    {
      "declarations": ["input name", "input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=other": "已将“{name}”标记为已完成，并解锁了 {count} 个配方"
      }
    }
  ],
  "search_reset": "已重置“{name}”",
  "action_undo": "撤销",
  "undo_marked_complete": "已将“{name}”标记为已完成",
  "undo_unmarked": "已取消标记“{name}”"
}
