{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "noImplicitReturns": true,
    "strict": true,
    "types": ["$app/types"]
  },
  "exclude": ["node_modules/**", "scripts/locale-fonts/**", "src/service-worker/**"],
  "include": [
    "src",
    "tests",
    "scripts/**/*.ts",
    "eslint-rules/**/*.ts",
    "relay/**/*.test.ts",
    "vite.config.ts"
  ]
}
