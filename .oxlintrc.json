// oxlint lints every script: `.ts`, `.js`, `.svelte.ts`, and `.svelte` `<script>` blocks.
// Type-aware rules run through tsgolint, which covers everything except `.svelte` files.
// Svelte template rules live in eslint.config.js. tests/lint-ownership.test.ts pins that boundary.
// See docs/development-workflow.md#linting--formatting.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "jsdoc"],
  "jsPlugins": ["eslint-plugin-perfectionist", "eslint-plugin-playwright"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error",
    "style": "error",
    "restriction": "error"
  },
  "options": { "typeAware": true },
  "env": { "builtin": true, "browser": true, "node": true },
  "ignorePatterns": [
    // Lint-ownership probes violate rules on purpose; tests/lint-ownership.test.ts lints them.
    "tests/lint-probes/",
    // Throwaway mockup generators kept beside a design package for reference, not app code.
    "docs/design/*/generator/",
    "**/node_modules",
    ".worktrees/",
    ".claude/worktrees/",
    "**/.output",
    "**/.wrangler",
    "**/.svelte-kit",
    "/build",
    "coverage",
    ".playwright-artifacts",
    ".playwright-report",
    ".playwright-results",
    ".playwright-pwa-report",
    ".playwright-pwa-results",
    ".pnpm-store",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.env",
    "**/.env.*",
    "**/.dev.vars",
    "!**/.env.example",
    "!**/.env.test",
    "**/vite.config.js.timestamp-*",
    "**/vite.config.ts.timestamp-*",
    "src/lib/components/icon/custom/raw",
    "src/lib/components/icon/custom/optimized",
    "pipeline/input",
    "pipeline/output",
    "static/sprites/",
    "static/villager-sprites/",
    "static/fonts/satoshi-regular.woff2",
    "src/lib/paraglide/",
    "project.inlang/*",
    "!project.inlang/settings.json",
    "scripts/locale-fonts/**",
    "scripts/locale-fonts/input/",
    ".locale-fonts-dist/"
  ],
  "rules": {
    // Every category except `nursery` is on, so an oxlint upgrade surfaces its new rules for triage.
    // Each rule below that's `off` says why, in one of three groups. See
    // docs/development-workflow.md#oxlint-rule-decisions for revisit conditions.

    // Rejected: conflicts with a convention this repo deliberately keeps.
    "eslint/capitalized-comments": "off", // Commented-out identifiers and code references.
    "eslint/func-style": "off", // Declarations & arrow callbacks each have their place.
    "eslint/id-length": "off", // Short callback names (`c`, `x`) read fine in tight scopes.
    "eslint/init-declarations": "off", // `let x: T;` assigned in branches is the clearest form.
    "eslint/max-classes-per-file": "off", // Error classes & test fakes live beside their users.
    "eslint/no-bitwise": "off", // Transfer encoding & the save parser pack bits deliberately.
    "eslint/no-continue": "off", // Guard-clause `continue` beats nested loop bodies.
    "eslint/no-duplicate-imports": "off", // `import type` lines repeat a path; import/no-duplicates owns this.
    "eslint/no-magic-numbers": "off", // Game data and layout constants are self-describing in place.
    "eslint/no-plusplus": "off", // oxfmt's semicolons remove the ASI hazard this rule guards.
    "eslint/no-ternary": "off", // Ternaries are idiomatic in Svelte markup & `$derived`.
    "eslint/no-undefined": "off", // TypeScript optional values are `undefined`, by design.
    "eslint/no-use-before-define": "off", // Hoisted helpers below their caller; TypeScript catches TDZ.
    "eslint/no-void": "off", // `void promise` marks intentional fire-and-forget for no-floating-promises.
    "eslint/no-underscore-dangle": "off", // SvelteKit `_`-prefixed exports; `_` marks unused bindings.
    "eslint/one-var": "off", // One declaration per statement is the repo style.
    "eslint/prefer-destructuring": "off", // `const x = arr[0]` is clearer than `[x] = arr`.
    "eslint/sort-imports": "off", // oxfmt sorts import statements; perfectionist sorts specifiers.
    "eslint/sort-keys": "off", // perfectionist/sort-objects owns key order, with domain groups.
    "import/exports-last": "off", // Exports sit beside their implementation.
    "import/group-exports": "off", // Same.
    "import/no-default-export": "off", // Config files and SvelteKit hooks require default exports.
    "import/no-named-export": "off",
    "import/no-namespace": "off", // Paraglide messages import as `* as m`, by its convention. // Named exports are the repo convention.
    "import/no-nodejs-modules": "off", // The pipeline and scripts are Node programs.
    "import/no-unassigned-import": "off", // CSS & polyfill side-effect imports.
    "import/prefer-default-export": "off",
    "jsdoc/require-param": "off", // TypeScript signatures document parameters; JSDoc is prose.
    "jsdoc/require-param-description": "off", // Same.
    "jsdoc/require-param-type": "off", // Same.
    "jsdoc/require-returns": "off", // Same. // Named exports are the repo convention.
    "import/unambiguous": "off", // Ambient `.d.ts` files are scripts by design.
    "node/no-process-env": "off", // Vite config and CLIs read the environment directly.
    "node/no-sync": "off", // The pipeline and scripts are sequential CLIs.
    "node/no-top-level-await": "off", // ESM entry points use top-level await (unicorn/prefer-top-level-await).
    "oxc/no-async-await": "off", // ES-target restriction; the build targets modern runtimes.
    "oxc/no-optional-chaining": "off", // Same.
    "oxc/no-rest-spread-properties": "off", // Same.
    "oxc/no-map-spread": "off", // Immutable updates are deliberate; its fix mutates shared objects.
    "promise/avoid-new": "off", // Wrapping callback & event APIs needs `new Promise`.
    "typescript/explicit-function-return-type": "off", // Inference for callbacks; module boundaries are checked.
    "typescript/explicit-member-accessibility": "off", // TypeScript members are public by default.
    "typescript/prefer-readonly-parameter-types": "off", // Deep-readonly props & DOM types are impractical.
    "unicorn/import-style": "off", // Named imports from Node built-ins are the repo convention.
    "unicorn/no-null": "off",
    "unicorn/prefer-query-selector": "off", // `getElementById` needs no CSS escaping and returns `HTMLElement`. // DOM, JSON, and Svelte APIs speak `null`.
    "unicorn/number-literal-case": "off", // Conflicts with oxfmt's lowercase hex digits.

    // Contradicts a stricter rule that's on.
    "default-case": "off", // typescript/switch-exhaustiveness-check proves switches complete.
    "eslint/require-await": "off", // typescript/require-await knows when an async function returns a thenable.
    "typescript/promise-function-async": "off", // Its `async` fix makes require-await flag pass-through returns.
    "unicorn/no-nested-ternary": "off", // eslint/no-nested-ternary is stricter.

    // Deferred: worthwhile, but the backlog needs its own scoping. Revisit conditions live in the doc.
    "eslint/complexity": "off",
    "eslint/max-depth": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/max-params": "off",
    "eslint/max-statements": "off",
    "eslint/no-inline-comments": "off",
    "eslint/prefer-named-capture-group": "off",
    "eslint/require-unicode-regexp": "off",
    "import/max-dependencies": "off",
    "import/no-relative-parent-imports": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/strict-boolean-expressions": "off",
    "typescript/strict-void-return": "off",
    "unicorn/max-nested-calls": "off",
    "unicorn/no-useless-undefined": "off",

    // Configured category rules
    "import/extensions": ["error", "always", { "ignorePackages": true }],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/switch-case-braces": ["error", "avoid"],

    // Core rules beyond the `correctness` category
    "curly": ["error", "multi-line", "consistent"],
    "eqeqeq": "error",
    "no-alert": "error",
    "no-array-constructor": "error",
    "no-case-declarations": "error",
    "no-console": "warn",
    "no-empty": "error",
    "no-empty-function": "error",
    "no-fallthrough": "error",
    "no-prototype-builtins": "error",
    "no-redeclare": "error",
    "no-regex-spaces": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "allowTypeImports": true,
            "message": "Import icons individually, e.g. from \"@tabler/icons-svelte-runes/icons/x\".",
            "name": "@tabler/icons-svelte-runes"
          }
        ]
      }
    ],
    "no-undef": "error",
    "no-unneeded-ternary": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-useless-assignment": "error",
    "no-useless-constructor": "error",
    "no-var": "error",
    "object-shorthand": "error",
    "prefer-const": "error",
    "prefer-template": "error",
    "preserve-caught-error": "error",

    // typescript-eslint's strict & stylistic type-checked presets, minus `correctness` rules
    "typescript/adjacent-overload-signatures": "error",
    "typescript/array-type": "error",
    "typescript/ban-ts-comment": ["error", { "minimumDescriptionLength": 10 }],
    "typescript/ban-tslint-comment": "error",
    "typescript/class-literal-property-style": "error",
    "typescript/consistent-generic-constructors": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/consistent-type-assertions": "error",
    "typescript/consistent-type-definitions": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/dot-notation": "error",
    "typescript/no-confusing-non-null-assertion": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extraneous-class": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-condition": "warn",
    "typescript/no-unnecessary-template-expression": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-constraint": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-for-of": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-includes": "error",
    "typescript/prefer-literal-enum-member": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/prefer-return-this-type": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": [
      "error",
      {
        "allowAny": false,
        "allowBoolean": false,
        "allowNullish": false,
        "allowNumberAndString": false,
        "allowRegExp": false
      }
    ],
    "typescript/restrict-template-expressions": ["error", { "allowNumber": true }],
    "typescript/return-await": ["error", "error-handling-correctness-only"],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unified-signatures": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",

    // Sorting that oxfmt doesn't do. oxfmt sorts import statements, not the names inside them.
    "perfectionist/sort-enums": ["error", { "type": "natural", "order": "asc" }],
    "perfectionist/sort-exports": ["error", { "type": "natural", "order": "asc" }],
    "perfectionist/sort-interfaces": ["error", { "type": "natural", "order": "asc" }],
    "perfectionist/sort-intersection-types": ["error", { "type": "natural", "order": "asc" }],
    "perfectionist/sort-named-exports": ["error", { "type": "natural", "order": "asc" }],
    "perfectionist/sort-named-imports": ["error", { "type": "natural", "order": "asc" }],
    "perfectionist/sort-object-types": [
      "error",
      {
        "customGroups": [
          { "elementNamePattern": "^start$", "groupName": "range-start" },
          { "elementNamePattern": "^end$", "groupName": "range-end" },
          { "elementNamePattern": "^type$", "groupName": "type-discriminator" }
        ],
        "groups": ["type-discriminator", "range-start", "range-end", "unknown"]
      }
    ],
    "perfectionist/sort-objects": [
      "error",
      {
        "customGroups": [
          { "elementNamePattern": "^start$", "groupName": "range-start" },
          { "elementNamePattern": "^end$", "groupName": "range-end" },
          { "elementNamePattern": "^type$", "groupName": "type-discriminator" }
        ],
        "groups": ["type-discriminator", "range-start", "range-end", "unknown"],
        "partitionByNewLine": true
      }
    ],
    "perfectionist/sort-union-types": ["error", { "type": "natural", "order": "asc" }]
  },
  "overrides": [
    {
      // Vitest rules apply to unit tests only; Playwright specs under tests/ use a different API.
      "files": ["**/*.test.ts"],
      "plugins": ["vitest"],
      "rules": {
        // Assertion helpers are named `expect*`, like `expectDecodeError`.
        // ESLint's RuleTester registers its own `describe`/`it` blocks.
        "vitest/require-hook": ["error", { "allowedFunctionCalls": ["tester.run"] }],
        "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expect*"] }],
        "vitest/consistent-test-it": ["error", { "fn": "it", "withinDescribe": "it" }],
        "vitest/max-expects": "off", // Table-style tests assert many facts about one fixture.
        "vitest/no-hooks": "off", // `beforeEach` resets shared fakes.
        "vitest/no-importing-vitest-globals": "off", // Vitest globals are off; tests import `vi`, `expect`, & co.
        "vitest/prefer-describe-function-title": "off", // Describe titles name behaviors, not only functions.
        "vitest/prefer-expect-assertions": "off",
        "vitest/prefer-expect-resolves": "off", // jest-dom matchers under `.resolves` aren't typed as thenables, so await-thenable rejects the rewrite.
        "vitest/prefer-lowercase-title": "off",
        "vitest/prefer-mock-return-shorthand": "off", // Its fix shares one value across calls that must each build their own (fresh promises, side effects). // Describe titles name PascalCase components & types. // Typed, synchronous assertions can't silently skip.
        "vitest/require-test-timeout": "off", // The global Vitest timeout applies.
        "vitest/require-top-level-describe": "off", // Small test files don't need a wrapper.
        "vitest/prefer-called-once": "off", // vitest/prefer-called-times states every count the same way.
        "vitest/prefer-strict-boolean-matchers": "off", // Its fix turns truthiness checks on elements into `toBe(true)`.
        "vitest/prefer-to-be-falsy": "off", // `toBe(false)` is stricter on real booleans.
        "vitest/prefer-to-be-truthy": "off", // `toBe(true)` is stricter on real booleans.
        "vitest/no-conditional-expect": "error", // An expect behind a branch or catch can silently never run.
        "vitest/no-conditional-in-test": "off",
        "vitest/prefer-import-in-mock": "off",
        "vitest/prefer-strict-equal": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/valid-expect": ["error", { "maxArgs": 2 }]
      }
    },
    {
      // Playwright rules (eslint-plugin-playwright, loaded as an oxlint JS plugin) cover the browser
      // suites. Sleeps are never allowed; raw CSS & XPath locators are, only where a role or label
      // can't express the query.
      "files": ["tests/**/*.spec.ts", "tests/accessibility/support/**/*.ts", "tests/pwa/**/*.ts"],
      "rules": { "playwright/no-raw-locators": "error", "playwright/no-wait-for-timeout": "error" }
    },
    {
      // These suites inspect DOM structure that has no role or name: document metadata (seo) and
      // layout geometry on data-* hooks (geometry). Semantic locators can't reach it.
      "files": [
        "tests/accessibility/geometry.spec.ts",
        "tests/accessibility/seo.spec.ts",
        "tests/accessibility/support/geometry.ts"
      ],
      "rules": { "playwright/no-raw-locators": "off" }
    },
    {
      // Playwright specs drive one page through ordered steps, so their awaits are sequential.
      "files": ["tests/**/*.ts"],
      "rules": { "no-await-in-loop": "off" }
    },
    {
      // TypeScript reports these itself (typescript-eslint's eslint-recommended overrides). Every
      // `.svelte` script is `lang="ts"`, so the same applies there.
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "**/*.svelte"],
      "rules": {
        "constructor-super": "off",
        "getter-return": "off",
        "no-class-assign": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-undef": "off",
        "no-unreachable": "off",
        "no-unsafe-negation": "off",
        "no-with": "off",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    },
    {
      // From eslint-plugin-svelte's base config: Svelte's compiled output makes these misfire
      "files": ["**/*.svelte"],
      "rules": {
        "no-inner-declarations": "off",
        "no-self-assign": "off"
      }
    },
    {
      "files": ["**/*.svelte", "**/*.svelte.ts"],
      "rules": {
        // Svelte requires `let` for $props() destructuring (reactivity)
        "prefer-const": "off",
        // {@render children()} triggers a false positive
        "typescript/no-unsafe-call": "off"
      }
    },
    {
      // Pipeline & scripts are CLI tools: console output is intentional, and game data is loosely
      // typed, so defensive checks against `unknown` casts are valid
      "files": ["pipeline/**/*.ts", "scripts/**/*.ts"],
      "rules": {
        "no-console": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-return": "off"
      }
    },
    {
      "files": ["pipeline/**/*.ts"],
      "rules": { "typescript/no-unsafe-assignment": "error" }
    },
    {
      // The engine is pure domain logic: it must not reach up into stores, components, or Paraglide messages, even
      // for types. Shared domain types live in `src/lib/types/`. Options replace the base rule's,
      // so the icon restriction is restated.
      "files": ["src/lib/engine/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "allowTypeImports": true,
                "message": "Import icons individually, e.g. from \"@tabler/icons-svelte-runes/icons/x\".",
                "name": "@tabler/icons-svelte-runes"
              }
            ],
            "patterns": [
              {
                "message": "The engine is pure domain logic; move shared types to src/lib/types/ and keep side effects and message lookups at store or component boundaries.",
                "regex": "^(#lib/|(?:\\.\\./)+)(stores|components|paraglide)/"
              }
            ]
          }
        ]
      }
    },
    {
      // `utils/` holds low-level helpers that every layer may import, so it must not reach up into
      // the layers built on it, even for types. Options replace the base rule's, so the icon
      // restriction is restated.
      "files": ["src/lib/utils/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "allowTypeImports": true,
                "message": "Import icons individually, e.g. from \"@tabler/icons-svelte-runes/icons/x\".",
                "name": "@tabler/icons-svelte-runes"
              }
            ],
            "patterns": [
              {
                "message": "utils/ is for low-level helpers; code that needs components, stores, controllers, effects, sources, PWA, or presentation modules belongs in that layer instead.",
                "regex": "^(#lib/|(?:\\.\\./)+)(components|stores|controllers|effects|sources|pwa|presentation)/"
              }
            ]
          }
        ]
      }
    },
    {
      // Components forked from shadcn-svelte keep its import style, so relax those strict rules
      "files": ["src/lib/components/ui/**/*.svelte", "src/lib/components/ui/**/*.ts"],
      "rules": {
        "import/consistent-type-specifier-style": "off",
        "import/no-cycle": "off",
        "import/newline-after-import": "off",
        "import/no-duplicates": "off",
        "typescript/explicit-module-boundary-types": "off",
        "unicorn/prefer-export-from": "off",
        "perfectionist/sort-named-exports": "off",
        "perfectionist/sort-object-types": "off",
        "perfectionist/sort-objects": "off",
        "typescript/consistent-type-imports": "off",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/prefer-nullish-coalescing": "off"
      }
    },
    {
      // No usable type information: the service worker uses the webworker lib outside the main
      // tsconfig, and the JS config files & local ESLint rules are untyped
      "files": [
        "src/service-worker/**/*.ts",
        "*.config.{js,ts}",
        "*.config.*.{js,ts}",
        "eslint-rules/**/*.js"
      ],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/consistent-return": "off",
        "typescript/consistent-type-exports": "off",
        "typescript/dot-notation": "off",
        "typescript/no-array-delete": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-confusing-void-expression": "off",
        "typescript/no-deprecated": "off",
        "typescript/no-duplicate-type-constituents": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-for-in-array": "off",
        "typescript/no-implied-eval": "off",
        "typescript/no-meaningless-void-operator": "off",
        "typescript/no-misused-promises": "off",
