# Cloudflare Turnstile — anti-bot verification for the feedback form.
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# GitHub App the feedback endpoint files issues as. Installed only on this repository with
# Repository permissions → Issues: Read & write. Setup & key handling:
# docs/app-architecture.md#8-feedback-credentials. The endpoint requires all three App settings.
# The two IDs are not secret; the private key is, & lives only in production as a Pages secret.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PKCS#8 PEM ("BEGIN PRIVATE KEY"); GitHub's download is PKCS#1 & must be converted first.
GITHUB_APP_PRIVATE_KEY=

# Cloudflare Workers KV namespace binding name for storing feedback
# contact emails. Declared in wrangler.toml's kv_namespaces, not as an env var.
# Optional at runtime: without it (e.g. under `pnpm run dev`), feedback still
# files the issue & reports emailSaved: false. Listed for documentation only.
# FEEDBACK_EMAIL_STORE=<KV namespace binding>
