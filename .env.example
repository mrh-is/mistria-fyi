# Cloudflare Turnstile — anti-bot verification for the feedback form.
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# GitHub personal access token (classic) with `public_repo` scope.
# Used by the feedback endpoint to create issues on this repository.
GITHUB_FEEDBACK_TOKEN=

# Cloudflare Workers KV namespace binding name for storing feedback
# contact emails. Bound on the Pages project in the Cloudflare dashboard
# (wrangler.toml declares no kv_namespaces, so the dashboard stays the source
# of truth), not as an env var. Optional at runtime: without it, feedback
# still files the issue & reports emailSaved: false. Listed for documentation only.
# FEEDBACK_EMAIL_STORE=<KV namespace binding>
