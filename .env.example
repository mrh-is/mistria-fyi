# Cloudflare Turnstile — anti-bot verification for the feedback form.
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# GitHub fine-grained personal access token, restricted to this repository only.
# Grant "Issues" read & write permission; "Metadata" read is implied.
# Used by the feedback endpoint to create issues on this repository.
GITHUB_FEEDBACK_TOKEN=

# Cloudflare Workers KV namespace binding name for storing feedback
# contact emails. Declared in wrangler.toml's kv_namespaces, not as an env var.
# Optional at runtime: without it (e.g. under `pnpm run dev`), feedback still
# files the issue & reports emailSaved: false. Listed for documentation only.
# FEEDBACK_EMAIL_STORE=<KV namespace binding>
