{
  "cSpell.ignorePaths": ["pipeline/input", "pipeline/output", "src/lib/components/ui"],
  "cSpell.words": [
    "bitfield",
    "bunx",
    "completionist",
    "completionists",
    "cutscene",
    "cutscenes",
    "divespot",
    "FOUC",
    "forageable",
    "forageables",
    "gamedata",
    "Helmbrecht",
    "LOCALAPPDATA",
    "mistmare",
    "Mistria",
    "mistril",
    "NPC",
    "NPCs",
    "Noto",
    "oklch",
    "overscroll",
    "qrcode",
    "Segoe",
    "spoilered",
    "stylesheet",
    "unreviewed",
    "vaultc",
    "vite",
    "WCAG"
  ],
  "json.schemaDownload.trustedDomains": {
    "https://shadcn-svelte.com/schema.json": true
  },
  "json.schemas": [
    {
      "fileMatch": ["bun.lock"],
      "schema": {
        "allowTrailingCommas": true
      }
    }
  ],
  "prettier.documentSelectors": ["**/*.svelte"]
}
