{
  "name": "mistria-fyi",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.15.32",
  "type": "module",
  "scripts": {
    "prepare": "husky && pnpm run paraglide:compile && svelte-kit sync",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p pipeline/tsconfig.json",
    "check:i18n": "tsx scripts/check-translation-keys.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:pipeline": "tsc --noEmit -p pipeline/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cloudflare:logs": "tsx scripts/cloudflare-pages-logs.ts",
    "lint": "prettier --check . && eslint . --cache --cache-location node_modules/.cache/eslint/ && stylelint \"src/**/*.{css,svelte}\"",
    "lint:fix": "prettier --write . && eslint . --fix --cache --cache-location node_modules/.cache/eslint/ && stylelint \"src/**/*.{css,svelte}\" --fix",
    "optimize-icons": "svgo --config svgo.config.js -f src/lib/components/icon/custom/raw -o src/lib/components/icon/custom/optimized",
    "pipeline": "cd pipeline && tsx src/main.ts",
    "test": "vitest run --project=!assets",
    "verify": "bash scripts/verify.sh",
    "worktree:new": "bash scripts/new-worktree.sh",
    "accessibility:monitor": "tsx scripts/accessibility-monitor.ts",
    "generate:brand-assets": "tsx scripts/generate-brand-assets.ts",
    "test:accessibility": "playwright test",
    "test:accessibility:critical": "playwright test --grep @critical",
    "test:app": "vitest run --project=app --project=mocked --project=client",
    "test:client": "vitest run --project=client",
    "test:mocked": "vitest run --project=mocked",
    "test:pipeline": "vitest run --project=node pipeline/",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:server": "vitest run --project=app --project=mocked --project=node",
    "test:pipeline:assets": "vitest run --project=assets",
    "fonts:build": "tsx scripts/locale-fonts/build-locale-fonts.ts",
    "fonts:upload": "bash scripts/locale-fonts/upload-locale-fonts.sh",
    "sprites:upload": "bash scripts/sprites/upload-sprites.sh",
    "sprites:villagers": "pnpm run pipeline -- --sprites-only"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/biz-udpmincho": "^5.3.0",
    "@fontsource/cactus-classical-serif": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/lxgw-wenkai-mono-tc": "^5.3.0",
    "@fontsource/lxgw-wenkai-tc": "^5.3.0",
    "@fontsource/m-plus-1-code": "^5.3.0",
    "@fontsource/m-plus-1p": "^5.3.0",
    "@fontsource/nanum-gothic": "^5.3.0",
    "@fontsource/nanum-gothic-coding": "^5.3.0",
    "@fontsource/noto-sans-tc": "^5.3.0",
    "@fontsource/noto-serif-tc": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@inlang/plugin-message-format": "4.4.0",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.2",
    "@types/yauzl-promise": "^4.0.1",
    "axe-core": "^4.13.0",
    "bits-ui": "^2.19.2",
    "clsx": "^2.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-svelte": "^3.23.0",
    "fontkit": "^2.0.4",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "subset-font": "^2.7.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "svgo": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1",
    "yauzl-promise": "^4.0.0"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@tabler/icons-svelte-runes": "^3.47.0",
    "canvas-confetti": "^1.9.4",
    "qr": "^0.7.0"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  }
}
