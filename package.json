{
  "name": "mistria-fyi",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.15.33",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.ts && pnpm run paraglide:compile && svelte-kit sync",
    "paraglide:compile": "tsx scripts/paraglide-compile.ts",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json && tsc --noEmit -p pipeline/tsconfig.json",
    "check:i18n": "tsx scripts/check-translation-keys.ts",
    "check:built": "tsx --test --test-timeout=120000 --test-force-exit tests/build-output/*.spec.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "cloudflare:logs": "tsx scripts/cloudflare-pages-logs.ts",
    "lint": "node scripts/lint-files.ts",
    "lint:fix": "node scripts/lint-files.ts --fix",
    "lint:shell": "node scripts/lint-shell.ts",
    "optimize-icons": "svgo --config svgo.config.js -f src/lib/components/icon/custom/raw -o src/lib/components/icon/custom/optimized",
    "pipeline": "cd pipeline && tsx src/main.ts",
    "pipeline:assets": "pnpm run pipeline -- pipeline/input --version=current",
    "pipeline:atlas": "cd pipeline && tsx src/atlas/main.ts",
    "test": "vitest run --project=!assets",
    "test:changed": "node scripts/test-changed.ts",
    "test:coverage": "vitest run --project=!assets --coverage",
    "verify": "node scripts/verify.ts",
    "worktree:new": "node scripts/new-worktree.ts",
    "worktree:cleanup": "node scripts/cleanup-merged-worktrees.ts",
    "worktree:cleanup:apply": "node scripts/cleanup-merged-worktrees.ts --apply",
    "housekeeping:install": "bash scripts/install-housekeeping-agent.sh",
    "accessibility:monitor": "tsx scripts/accessibility-monitor.ts",
    "generate:brand-assets": "tsx scripts/generate-brand-assets.ts",
    "test:accessibility": "playwright test",
    "test:accessibility:critical": "playwright test --grep @critical",
    "test:app": "vitest run --project=app --project=isolated --project=cold --project=client --project=client-isolated",
    "test:client": "vitest run --project=client --project=client-isolated",
    "test:pipeline": "vitest run --project=pipeline",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:pipeline:assets": "vitest run --project=assets",
    "fonts:install": "pnpm --dir scripts/locale-fonts install --frozen-lockfile",
    "fonts:build": "pnpm --dir scripts/locale-fonts run build",
    "fonts:check": "pnpm --dir scripts/locale-fonts run check",
    "fonts:lint": "pnpm --dir scripts/locale-fonts run lint",
    "fonts:upload": "node scripts/upload-locale-fonts.ts",
    "game-assets:share": "tsx pipeline/src/share-game-assets.ts",
    "sprites:manifest": "tsx scripts/sprites/sprite-manifest.ts",
    "sprites:upload": "node scripts/sprites/upload-sprites.ts",
    "sprites:villagers": "pnpm run pipeline -- --villager-sprites-only"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^2.1.1",
    "@inlang/plugin-message-format": "4.4.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postcss-html": "^2.0.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.26.0",
    "@tabler/icons-svelte-runes": "^3.49.0",
    "bits-ui": "^2.19.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "qr": "^0.7.2",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.15.0 <27.0.0"
  },
  "imports": {
    "#game-version": "./pipeline/src/game-version.ts",
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#scripts/*": "./scripts/*.ts"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  }
}
