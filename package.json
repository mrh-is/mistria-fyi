{
  "name": "mistria-fyi",
  "private": true,
  "license": "GPL-3.0-only",
  "version": "0.15.33",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.ts && pnpm run messages:compile && svelte-kit sync",
    "messages:compile": "node scripts/compile-wuchale.ts",
    "messages:extract": "wuchale --clean",
    "dev": "vite dev",
    "dev:feedback": "tsx scripts/dev-feedback.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json && tsc --noEmit -p pipeline/tsconfig.json && tsc --noEmit -p relay/tsconfig.json",
    "check:i18n": "node scripts/check-wuchale-catalogs.ts",
    "check:built": "tsx --test --test-concurrency=1 --test-timeout=120000 --test-force-exit tests/build-output/*.spec.ts",
    "check:routes": "tsx scripts/check-routes.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "knip": "knip",
    "data:diff": "node scripts/data-diff.ts",
    "game-update:report": "node scripts/game-update-report.ts",
    "cloudflare:logs": "tsx scripts/cloudflare-pages-logs.ts",
    "lint": "node scripts/lint-files.ts",
    "lint:fix": "node scripts/lint-files.ts --fix",
    "lint:shell": "node scripts/lint-shell.ts",
    "optimize-icons": "svgo --config svgo.config.js -f src/lib/components/icon/custom/raw -o src/lib/components/icon/custom/optimized",
    "pipeline": "cd pipeline && tsx src/main.ts",
    "pipeline:assets": "pnpm run pipeline -- pipeline/input --version=current",
    "pipeline:atlas": "cd pipeline && tsx src/atlas/main.ts",
    "test": "vitest run --project=!assets --project=!saves",
    "test:coverage": "vitest run --project=!assets --project=!saves --coverage",
    "verify": "node scripts/verify.ts",
    "worktree:new": "node scripts/new-worktree.ts",
    "issue-fields": "node scripts/issue-fields.ts",
    "start-work": "node scripts/start-work.ts",
    "worktree:cleanup": "bash scripts/cleanup-worktrees.sh",
    "worktree:cleanup:apply": "bash scripts/cleanup-worktrees.sh --apply",
    "housekeeping:install": "bash scripts/install-housekeeping-agent.sh",
    "generate:brand-assets": "tsx scripts/generate-brand-assets.ts",
    "test:accessibility": "playwright test",
    "test:accessibility:critical": "playwright test --grep @critical",
    "test:app": "vitest run --project=app --project=isolated --project=cold --project=client --project=client-isolated",
    "test:client": "vitest run --project=client --project=client-isolated",
    "test:pipeline": "vitest run --project=pipeline",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "test:pipeline:assets": "vitest run --project=assets",
    "test:saves": "vitest run --project=saves",
    "saves:fetch": "node scripts/save-fixtures.ts fetch",
    "saves:upload": "node scripts/save-fixtures.ts upload",
    "fonts:install": "pnpm --dir scripts/locale-fonts install --frozen-lockfile",
    "fonts:build": "pnpm --dir scripts/locale-fonts run build",
    "fonts:check": "pnpm --dir scripts/locale-fonts run check",
    "fonts:lint": "pnpm --dir scripts/locale-fonts run lint",
    "fonts:upload": "node scripts/upload-locale-fonts.ts",
    "game-assets:share": "tsx pipeline/src/share-game-assets.ts",
    "game-term": "cd pipeline && tsx src/game-term.ts",
    "r2:check": "node scripts/r2-check.ts",
    "sprites:manifest": "tsx scripts/sprites/sprite-manifest.ts",
    "sprites:report": "tsx scripts/sprites/sprite-report.ts",
    "sprites:upload": "node scripts/sprites/upload-sprites.ts",
    "sprites:villagers": "pnpm run pipeline -- --villager-sprites-only"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-cloudflare": "^8.0.3",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/load-config": "^0.2.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@wuchale/svelte": "0.21.4",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-perfectionist": "^5.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.2",
    "miniflare": "5.20261119.0-beta",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "postcss-html": "^2.0.1",
    "sharp": "^0.35.5",
    "stylelint": "^18.1.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.11.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-safe-area": "^2.0.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wuchale": "0.26.7",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@tabler/icons-svelte-runes": "^3.52.0",
    "bits-ui": "^2.22.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "qr": "^0.7.2",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^4.0.2",
    "valibot": "^1.5.0"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.15.0 <27.0.0"
  },
  "imports": {
    "#game-version": "./pipeline/src/game-version.ts",
    "#lib/*": "./src/lib/*",
    "#relay/*": "./relay/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
