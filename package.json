{
  "name": "mistria-fyi",
  "private": true,
  "version": "0.15.1",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p pipeline/tsconfig.json",
    "check:pipeline": "tsc --noEmit -p pipeline/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "pipeline": "cd pipeline && tsx src/main.ts",
    "test": "pnpm run test:server && pnpm run test:client",
    "test:app": "vitest run src/ && pnpm run test:client",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:pipeline": "vitest run pipeline/",
    "test:server": "vitest run",
    "test:pipeline:assets": "vitest run --config vitest.assets.config.ts"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.31.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/wicg-file-system-access": "^2023.10.7",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-safe-area": "^1.3.0",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  }
}
