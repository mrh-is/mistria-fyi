{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Knip reads the SvelteKit & Vitest setup from vite.config.ts. Entries here are files that nothing
  // imports because a runner, a hook, or a package script starts them.
  "workspaces": {
    ".": {
      "entry": [
        // `node scripts/<name>.ts` (package scripts, hooks, CI, & docs).
        "scripts/*.ts",
        // SvelteKit's universal hooks module (`reroute`), loaded by the framework.
        "src/hooks.ts",
        // Fixtures the lint-ownership test feeds to ESLint & oxlint; nothing imports them.
        "tests/lint-probes/*",
      ],
      "ignore": [
        // `scripts/locale-fonts/` is its own pnpm package with its own scripts & dependencies.
        "scripts/locale-fonts/**",
        // Components with no importers, awaiting deletion (#112; an edit hook refused the delete).
        "src/lib/components/ui/badge/**",
        "src/lib/components/ui/card/**",
        "src/lib/components/ui/progress/**",
      ],
      "ignoreDependencies": [
        // Registered by name in project.inlang/settings.json, never imported.
        "@inlang/plugin-message-format",
        // A Workers runtime module (`cloudflare:workers`), not an npm package.
        "cloudflare",
      ],
    },
    "pipeline": {
      // The atlas CLI starts through `cd pipeline && tsx src/atlas/main.ts`, which Knip does not follow.
      "entry": ["src/main.ts", "src/atlas/main.ts"],
    },
  },
  "ignoreIssues": {
    // The ui/ barrels follow shadcn-svelte's namespace pattern (`Root`, `DialogContent` aliases),
    // so some exported names are intentionally unused.
    "src/lib/components/ui/**": ["exports", "types"],
    // The shared data-contract barrel (`docs/app-architecture.md`, Generated Data Contracts)
    // re-exports every contract type for the app & the pipeline, used or not yet.
    "src/lib/types/tracker-data.ts": ["types"],
    // `page` is `$app/state`'s export name, so the stub exports one object under two names.
    "src/lib/test-utils/page-stub.svelte.ts": ["duplicates"],
  },
  "ignoreBinaries": [
    // System tools the scripts probe for; contributors install them (docs/machine-setup.md).
    "shellcheck",
    "gitleaks",
  ],
  "ignoreExportsUsedInFile": true,
}
