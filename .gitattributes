# Normalize line endings to LF on commit, regardless of OS.
* text=auto eol=lf

# Binary files — no line ending conversion.
*.png binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated by the pipeline; GitHub collapses its diff by default (review with `pnpm run data:diff`).
src/lib/data/tracker-data.json linguist-generated=true

# Additional pipeline-generated locale data.
src/lib/data/locales.json linguist-generated=true
src/lib/data/locales/**/*.json linguist-generated=true

# Generated by scripts/locale-fonts/build-locale-fonts.ts.
src/lib/fonts/locale-fonts-*.css linguist-generated=true

# Handwritten project declarations, rather than vendored type definitions.
src/app.d.ts linguist-vendored=false
src/cloudflare-workers.d.ts linguist-vendored=false
scripts/locale-fonts/subset-font.d.ts linguist-vendored=false
