# Normalize line endings to LF on commit, regardless of OS.
* text=auto eol=lf

# Binary files — no line ending conversion.
*.png binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated by the pipeline; GitHub collapses its diff by default (review with `pnpm run data:diff`).
src/lib/data/tracker-data.json linguist-generated=true
