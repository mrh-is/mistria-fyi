# Permit the project commands used by the documented development workflow.
prefix_rule(
    pattern = [
        "pnpm",
        "run",
        [
            "build",
            "check",
            "check:i18n",
            "check:locale-sync",
            "check:routes",
            "check:built",
            "data:diff",
            "dev",
            "fonts:check",
            "fonts:lint",
            "game-update:report",
            "knip",
            "lint",
            "lint:fix",
            "lint:shell",
            "paraglide:compile",
            "pipeline",
            "pipeline:assets",
            "pipeline:atlas",
            "prepare",
            "preview",
            "sprites:manifest",
            "test",
            "test:accessibility",
            "test:accessibility:critical",
            "test:app",
            "test:changed",
            "test:client",
            "test:coverage",
            "test:pipeline",
            "test:pipeline:assets",
            "test:pwa",
            "verify",
            "worktree:new",
        ],
    ],
    decision = "allow",
    justification = "These are the repository's documented pnpm scripts.",
)

# Permit the setup scripts that run with plain Node, before dependencies exist.
prefix_rule(
    pattern = ["node", ["scripts/machine-doctor.ts", "scripts/setup-worktree.ts"]],
    decision = "allow",
    justification = "The read-only machine doctor & worktree setup run before pnpm install.",
)

# Permit the package-local tools used for focused development and verification.
prefix_rule(
    pattern = [
        "pnpm",
        "exec",
        [
            "eslint",
            "oxfmt",
            "oxlint",
            "playwright",
            "stylelint",
            "svelte-check",
            "svelte-kit",
            "tsx",
            "vitest",
        ],
    ],
    decision = "allow",
    justification = "These package-local tools are required by the repository workflow.",
)

# Permit reproducible dependency installation only.
prefix_rule(
    pattern = ["pnpm", "install", "--frozen-lockfile"],
    decision = "allow",
    justification = "The frozen lockfile keeps dependency installation reproducible.",
)

# Permit Git commands that only move refs or read repository metadata. Each writes under .git,
# which the sandbox protects, so without a rule every call escalates to an approval review.
prefix_rule(
    pattern = ["git", "fetch"],
    decision = "allow",
    justification = "Fetching updates remote-tracking refs only.",
)

prefix_rule(
    pattern = ["git", "merge", "--ff-only"],
    decision = "allow",
    justification = "A fast-forward cannot create a merge commit or conflict.",
)

prefix_rule(
    pattern = ["git", "pull", "--ff-only"],
    decision = "allow",
    justification = "A fast-forward cannot create a merge commit or conflict.",
)

prefix_rule(
    pattern = ["git", "rev-parse"],
    decision = "allow",
    justification = "This only reads repository metadata.",
)

prefix_rule(
    pattern = ["git", "remote", ["-v", "get-url", "show"]],
    decision = "allow",
    justification = "These forms only read remote configuration.",
)

# Permit read-only GitHub CLI commands plus routine lifecycle writes (issue comments & edits, PR
# comments); AGENTS.md §2 attributes each with an `Agent:` line, and each is easy to reverse.
# Creating issues & PRs, `gh pr edit`, `gh pr ready`, `gh pr merge`, and `gh api` stay out on
# purpose.
prefix_rule(
    pattern = ["gh", "pr", ["view", "list", "diff", "checks", "status", "comment"]],
    decision = "allow",
    justification = "These read pull request state or add an attributed, reversible comment.",
)

prefix_rule(
    pattern = ["gh", "issue", ["view", "list", "comment", "edit"]],
    decision = "allow",
    justification = "These read issue state or make attributed, reversible comment & label edits.",
)

prefix_rule(
    pattern = ["gh", "run", ["view", "list", "watch"]],
    decision = "allow",
    justification = "These only read CI runs.",
)

prefix_rule(
    pattern = ["gh", "label", "list"],
    decision = "allow",
    justification = "This only reads labels.",
)

# Permit read-only process inspection.
prefix_rule(
    pattern = [["pgrep", "lsof"]],
    decision = "allow",
    justification = "These only read process and port state.",
)

# Enforce the repository's pnpm-only package-manager policy.
prefix_rule(
    pattern = [["bun", "npm", "npx", "pnpx", "yarn"]],
    decision = "forbidden",
    justification = "Use the equivalent pnpm command required by AGENTS.md; run package-local tools with pnpm exec.",
)
