{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent-tool-hook.ts\"",
            "timeout": 600,
            "statusMessage": "Formatting the edit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/setup-worktree.ts\" --session-start",
            "statusMessage": "Initializing worktree",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
