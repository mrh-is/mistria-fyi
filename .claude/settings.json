{
  "permissions": {
    "allow": [
      "Bash(pnpm run lint *)",
      "Bash(pnpm run lint:fix *)",
      "Bash(pnpm run check *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run test:app *)",
      "Bash(pnpm run test:pipeline *)",
      "Bash(pnpm run test:client *)",
      "Bash(pnpm run test:server *)",
      "Bash(pnpm run test:mocked *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run verify *)",
      "Bash(pnpm run dev *)",
      "Bash(pnpm run pipeline *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec svelte-check *)",
      "Bash(pnpm exec svelte-kit *)",
      "Bash(pnpm exec oxfmt *)",
      "Bash(pnpm exec oxlint *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec playwright *)",
      "Bash(pnpm install --frozen-lockfile *)",
      "Bash(pnpm run prepare *)",
      "Bash(pnpm run worktree:new *)"
    ],
    "deny": ["Bash(npm *)", "Bash(npx *)", "Bash(yarn *)", "Bash(bun *)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-session-env.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
