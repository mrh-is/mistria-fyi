{
  "permissions": {
    "allow": [
      "Bash(pnpm run lint *)",
      "Bash(pnpm run lint:fix *)",
      "Bash(pnpm run lint:shell *)",
      "Bash(pnpm run check *)",
      "Bash(pnpm run check:i18n *)",
      "Bash(pnpm run check:locale-sync *)",
      "Bash(pnpm run check:routes *)",
      "Bash(pnpm run check:built *)",
      "Bash(pnpm run knip *)",
      "Bash(pnpm run data:diff *)",
      "Bash(pnpm run game-update:report *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run test:accessibility *)",
      "Bash(pnpm run test:accessibility:critical *)",
      "Bash(pnpm run test:app *)",
      "Bash(pnpm run test:pipeline *)",
      "Bash(pnpm run test:pipeline:assets *)",
      "Bash(pnpm run test:pwa *)",
      "Bash(pnpm run test:client *)",
      "Bash(pnpm run test:coverage *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run fonts:check *)",
      "Bash(pnpm run fonts:lint *)",
      "Bash(pnpm run messages:compile *)",
      "Bash(pnpm run sprites:manifest *)",
      "Bash(pnpm run preview *)",
      "Bash(pnpm run verify *)",
      "Bash(node scripts/machine-doctor.ts)",
      "Bash(node scripts/machine-doctor.ts *)",
      "Bash(pnpm run dev *)",
      "Bash(pnpm run pipeline *)",
      "Bash(pnpm run pipeline:assets *)",
      "Bash(pnpm run pipeline:atlas *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec svelte-check *)",
      "Bash(pnpm exec svelte-kit *)",
      "Bash(pnpm exec oxfmt *)",
      "Bash(pnpm exec oxlint *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec stylelint *)",
      "Bash(pnpm exec tsx *)",
      "Bash(pnpm exec playwright *)",
      "Bash(pnpm install --frozen-lockfile *)",
      "Bash(pnpm run prepare *)",
      "Bash(pnpm run worktree:new *)",
      "Bash(node scripts/setup-worktree.ts)"
    ],
    "deny": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpx *)",
      "Bash(yarn *)",
      "Bash(bun *)",
      "Read(**/.env.r2-upload)",
      "Read(**/src/lib/data/tracker-data.json)",
      "Edit(**/src/lib/data/tracker-data.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-tool-hook.ts\"",
            "timeout": 600,
            "statusMessage": "Formatting the edit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-session-env.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "Co-Authored-By: Claude Code <noreply@anthropic.com>",
    "pr": ""
  }
}
